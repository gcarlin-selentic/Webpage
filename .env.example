# Copy to .env.local for local development. In production set these in
# Vercel > Project > Settings > Environment Variables. Never commit real keys.

# Incident feed. Leave empty to use the public am-i-exposed radar feed
# (https://www.am-i-exposed.com/data/radar.json). Set to "mock" to serve
# data/mock-hacks.json. Any URL returning the documented Hack shape also works.
HACKS_API_URL=

# Optional. Sent as "Authorization: Bearer <key>" when set.
HACKS_API_KEY=

# Optional, opt-in analytics. Leave empty for no analytics at all.
# Example: www.selenticgroup.com (requires a Plausible account).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
